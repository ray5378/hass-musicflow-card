{
  "name": "hass-musicflow-card",
  "version": "1.0.0",
  "description": "MusicFlow player card for Home Assistant: full playback controls, favorite, add-to-playlist, scrolling lyrics and output switching.",
  "type": "module",
  "main": "dist/hass-musicflow-card.js",
  "scripts": {
    "build": "esbuild src/musicflow-card.js --bundle --format=esm --target=es2019 --outfile=dist/hass-musicflow-card.js --minify",
    "watch": "esbuild src/musicflow-card.js --bundle --format=esm --target=es2019 --outfile=dist/hass-musicflow-card.js --minify --watch"
  },
  "keywords": [
    "home-assistant",
    "hacs",
    "lovelace",
    "musicflow",
    "media-player",
    "dlna"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "lit": "^3.2.0"
  }
}
